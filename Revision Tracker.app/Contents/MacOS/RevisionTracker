#!/bin/bash
# Double-click launcher for macOS. Finds Python 3.9+ and starts Revision Tracker in the
# background; the app opens in its own window and quits itself when you close it.

APP_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
ROOT="$(dirname "$APP_DIR")"

candidates=(
  /Library/Frameworks/Python.framework/Versions/Current/bin/python3
  /opt/homebrew/bin/python3
  /usr/local/bin/python3
)
# Apple's /usr/bin/python3 only works once the Command Line Tools are installed; otherwise
# running it pops up an installer, so only try it when they're present.
if xcode-select -p >/dev/null 2>&1; then
  candidates+=(/usr/bin/python3)
fi

PY=""
for p in "${candidates[@]}"; do
  if [ -x "$p" ] && "$p" -c 'import sys, sqlite3; sys.exit(0 if sys.version_info >= (3, 9) else 1)' 2>/dev/null; then
    PY="$p"
    break
  fi
done

if [ -z "$PY" ]; then
  answer=$(osascript -e 'button returned of (display dialog "Revision Tracker needs Python 3 (version 3.9 or newer).\n\nInstall it from python.org, then double-click Revision Tracker again." buttons {"Cancel", "Open python.org"} default button 2 with title "Revision Tracker" with icon caution)' 2>/dev/null)
  if [ "$answer" = "Open python.org" ]; then
    open "https://www.python.org/downloads/macos/"
  fi
  exit 1
fi

cd "$ROOT" || exit 1
nohup "$PY" -m revision_tracker >/dev/null 2>&1 &
exit 0
